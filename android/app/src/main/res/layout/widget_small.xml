<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:id="@+id/small_root"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@android:color/transparent">

    <!-- ====================================================== -->
    <!-- CENTERED KKMusic PILL                                  -->
    <!-- ====================================================== -->

    <LinearLayout
        android:id="@+id/small_content"

        android:layout_width="match_parent"
        android:layout_height="66dp"

        android:layout_gravity="center"

        android:background="@drawable/widget_small_background"

        android:gravity="center_vertical"

        android:orientation="horizontal"

        android:padding="0dp">

        <!-- ================================================== -->
        <!-- ARTWORK                                             -->
        <!-- ================================================== -->

        <ImageView
            android:id="@+id/small_artwork"

            android:layout_width="52dp"
            android:layout_height="52dp"

            android:layout_marginStart="7dp"
            android:layout_marginEnd="7dp"

            android:contentDescription="@string/widget_small_name"

            android:scaleType="centerCrop" />

        <!-- ================================================== -->
        <!-- SONG INFO                                           -->
        <!-- ================================================== -->

        <LinearLayout

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:gravity="center_vertical"

            android:orientation="vertical">

            <TextView
                android:id="@+id/small_title"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:ellipsize="end"
                android:fontFamily="sans"
                android:includeFontPadding="false"
                android:maxLines="1"

                android:text="Song Name"

                android:textColor="@color/widget_black"

                android:textSize="15sp"

                android:textStyle="bold" />

            <TextView
                android:id="@+id/small_artist"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="1dp"

                android:ellipsize="end"
                android:fontFamily="sans"
                android:includeFontPadding="false"
                android:maxLines="1"

                android:text="Artist"

                android:textColor="@color/widget_artist"

                android:textSize="10sp" />

        </LinearLayout>

        <!-- ================================================== -->
        <!-- PREVIOUS                                           -->
        <!-- ================================================== -->

        <FrameLayout
            android:id="@+id/small_previous_slot"

            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageView
                android:id="@+id/small_previous_icon"

                android:layout_width="23dp"
                android:layout_height="23dp"

                android:layout_gravity="center"

                android:src="@drawable/ic_widget_prev" />

        </FrameLayout>

        <!-- ================================================== -->
        <!-- PLAY                                               -->
        <!-- ================================================== -->

        <FrameLayout
            android:id="@+id/small_play_slot"

            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageView
                android:id="@+id/small_play_icon"

                android:layout_width="27dp"
                android:layout_height="27dp"

                android:layout_gravity="center"

                android:src="@drawable/ic_widget_play"

                android:tint="@color/widget_pink" />

        </FrameLayout>

        <!-- ================================================== -->
        <!-- NEXT                                               -->
        <!-- ================================================== -->

        <FrameLayout
            android:id="@+id/small_next_slot"

            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageView
                android:id="@+id/small_next_icon"

                android:layout_width="23dp"
                android:layout_height="23dp"

                android:layout_gravity="center"

                android:src="@drawable/ic_widget_next" />

        </FrameLayout>

    </LinearLayout>

</FrameLayout>